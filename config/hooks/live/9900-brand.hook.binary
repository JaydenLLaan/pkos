#!/bin/bash
set -euo pipefail
python3 - <<'PY'
from pathlib import Path
import re
for root in ('binary/boot/grub','binary/isolinux'):
    if not Path(root).exists():
        continue
    for p in Path(root).rglob('*.cfg'):
        text=p.read_text()
        text=text.replace('Debian GNU/Linux','pkOS').replace('Debian','pkOS').replace('Live system','Try pkOS')
        if p.name=='grub.cfg':
            text='set timeout=5\nset menu_color_normal=light-gray/black\nset menu_color_highlight=white/dark-gray\n'+text
            m=re.search(r'menuentry[^\n]*\{.*?\n\}',text,re.S)
            if m:
                safe=m.group(0)
                safe=re.sub(r'menuentry[^\n]*\{', 'menuentry "Try pkOS — Intel graphics fallback" {',safe,count=1)
                safe=safe.replace('nvidia-drm.modeset=1','module_blacklist=nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm,nvidia_current,nvidia_current_drm,nvidia_current_modeset,nvidia_current_uvm nouveau.modeset=0')
                safe=safe.replace('quiet splash','')
                text+='\n'+safe+'\n'
        p.write_text(text)
PY
# A branded background for both the legacy and EFI live menus.
cp config/includes.chroot/usr/share/wallpapers/pkos-slate/contents/images/2560x1440.png binary/boot/grub/splash.png
cp config/includes.chroot/usr/share/grub/themes/pkos/theme.txt binary/boot/grub/live-theme/theme.txt
# The menu is sourced by GRUB before its timeout loop.
printf '\nset timeout=5\n' >> binary/boot/grub/grub.cfg
if [ -d binary/isolinux ]; then
  convert binary/boot/grub/splash.png -resize '640x480!' binary/isolinux/splash.png
fi

