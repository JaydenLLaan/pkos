#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
# Optional editor repository: signed, bounded requests, Kate always available.
if curl --fail --location --retry 2 --max-time 45 \
  https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg -o /tmp/vscodium.asc \
  && gpg --batch --yes --dearmor -o /usr/share/keyrings/vscodium-archive-keyring.gpg /tmp/vscodium.asc; then
  cat > /etc/apt/sources.list.d/vscodium.sources <<'EOF'
Types: deb
URIs: https://download.vscodium.com/debs
Suites: vscodium
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/vscodium-archive-keyring.gpg
EOF
  if ! apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=40 update \
    || ! apt-get install -y --no-install-recommends codium; then
    echo 'VSCodium repository unavailable; Kate is the installed editor.'
    rm -f /etc/apt/sources.list.d/vscodium.sources
  fi
fi
if command -v codium >/dev/null; then
  if [ ! -f /usr/share/applications/codium.desktop ]; then
    cat > /usr/share/applications/codium.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=VSCodium
GenericName=Code Editor
Exec=codium %F
Icon=vscodium
Terminal=false
StartupNotify=true
StartupWMClass=VSCodium
Categories=Development;IDE;TextEditor;
MimeType=text/plain;
EOF
  fi
else
  sed -i 's|applications:codium.desktop|applications:org.kde.kate.desktop|g' \
    /usr/share/plasma/look-and-feel/org.pkos.desktop/contents/layouts/org.kde.plasma.desktop-layout.js
fi
# Papirus' grey place icons keep the shell's single accent restrained.
python3 - <<'PY'
from pathlib import Path
import os
import re
import colorsys
for path in Path('/usr/share/icons/Papirus').glob('*/places/*.svg'):
    if path.is_symlink():
        target=os.readlink(path)
        grey=target.replace('-blue','-grey')
        if grey != target and (path.parent/grey).exists():
            path.unlink()
            path.symlink_to(grey)
# Keep Papirus' shapes, with a restrained slate rendition for pinned apps.
# Use its terminal glyph instead of Kitty's cat illustration.
terminal=Path('/usr/share/applications/kitty.desktop')
if terminal.exists():
    terminal.write_text(terminal.read_text().replace('Icon=kitty','Icon=utilities-terminal'))
names={'org.kde.dolphin','dolphin','system-file-manager','utilities-terminal',
       'vscodium','firefox','firefox-esr','systemsettings','preferences-system'}
seen=set()
def muted(match):
    value=match.group()[1:]
    r,g,b=(int(value[i:i+2],16)/255 for i in (0,2,4))
    h,s,v=colorsys.rgb_to_hsv(r,g,b)
    if s < .12:
        return match.group()
    # Retain light/dark detail while removing saturated product colours.
    if v < .3: return '#17212b'
    if v < .55: return '#596674'
    if v < .85: return '#8babc0'
    return '#b4c8d6'
for path in Path('/usr/share/icons/Papirus').glob('*/apps/*.svg'):
    if path.stem in names:
        real=path.resolve()
        if real in seen or not real.is_file(): continue
        seen.add(real)
        real.write_text(re.sub(r'#[0-9a-fA-F]{6}\b',muted,real.read_text()))
PY
# uv is isolated from the system Python and available to every user.
python3 -m venv /opt/pkos/uv
/opt/pkos/uv/bin/pip install --no-cache-dir uv
ln -sf /opt/pkos/uv/bin/uv /usr/local/bin/uv
ln -sf /opt/pkos/uv/bin/uvx /usr/local/bin/uvx

