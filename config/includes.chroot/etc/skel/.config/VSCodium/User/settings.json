{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "none",
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "native",
  "window.autoDetectColorScheme": false,
  "workbench.iconTheme": null,
  "window.zoomLevel": 0,
  "editor.fontFamily": "'JetBrains Mono', monospace",
  "editor.fontSize": 13,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": false,
  "terminal.integrated.defaultProfile.linux": "bash",
  "window.title": "${activeEditorShort}${separator}${rootName}",
  "terminal.integrated.fontFamily": "JetBrains Mono",
  "terminal.integrated.fontSize": 13,
  "telemetry.telemetryLevel": "off",
  "workbench.colorCustomizations": {
    "editor.background": "#10151b",
    "editor.foreground": "#edf2f7",
    "sideBar.background": "#17212b",
    "sideBar.foreground": "#edf2f7",
    "activityBar.background": "#17212b",
    "activityBar.foreground": "#edf2f7",
    "statusBar.background": "#17212b",
    "statusBar.noFolderBackground": "#17212b",
    "statusBar.debuggingBackground": "#17212b",
    "statusBar.foreground": "#edf2f7",
    "titleBar.activeBackground": "#17212b",
    "titleBar.activeForeground": "#edf2f7",
    "tab.activeBackground": "#10151b",
    "tab.inactiveBackground": "#17212b",
    "tab.activeBorderTop": "#8babc0",
    "editorGroupHeader.tabsBackground": "#17212b",
    "panel.background": "#10151b",
    "button.background": "#8babc0",
    "button.foreground": "#10151b",
    "list.activeSelectionBackground": "#33434f",
    "editor.selectionBackground": "#33434f",
    "focusBorder": "#8babc0",
    "terminal.background": "#10151b"
  }
}
